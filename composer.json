{
  "license": "MIT",
  "name": "krvh/minimal-php-async",
  "description": "Minimal learning Async implementation in PHP 8.5",
  "type": "library",
  "authors": [{"name": "krvh"}],
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "ergebnis/composer-normalize": true,
      "infection/extension-installer": true,
      "phpstan/extension-installer": true
    },
    "sort-packages": true
  },
  "require": {
    "php": ">=8.5"
  },
  "require-dev": {
    "ext-pcntl": "*",
    "deptrac/deptrac": "^4.6.0",
    "ergebnis/composer-normalize": "^2.50.0",
    "icanhazstring/composer-unused": "^0.9.6",
    "infection/infection": "^0.32.0",
    "maglnet/composer-require-checker": "^4.20.0",
    "nikic/php-fuzzer": "^0.0.11",
    "phpbench/phpbench": "^1.4.3",
    "phpmd/phpmd": "^2.15.0",
    "phpstan/extension-installer": "^1.4.3",
    "phpstan/phpstan": "^2.1.39",
    "phpstan/phpstan-phpunit": "^2.0.15",
    "phpstan/phpstan-strict-rules": "^2.0.10",
    "phpunit/phpunit": "^12.5.11",
    "psalm/plugin-phpunit": "^0.19.5",
    "rector/rector": "^2.3.6",
    "roave/backward-compatibility-check": "^8.18.0",
    "roave/infection-static-analysis-plugin": "^1.43.0",
    "roave/security-advisories": "dev-latest",
    "shipmonk/composer-dependency-analyser": "^1.8.4",
    "slevomat/coding-standard": "^8.27.1",
    "squizlabs/php_codesniffer": "^4.0.1",
    "vimeo/psalm": "^6.15.1"
  },
  "scripts": {
    "analyze": [
      "@phpstan",
      "@psalm",
      "@phan"
    ],
    "backward-compatibility": "php scripts/backward-compatibility.php",
    "bench": "phpbench run --report=aggregate",
    "check": [
      "@lint",
      "@test"
    ],
    "ci": [
      "@check",
      "@infection"
    ],
    "coverage": "php scripts/coverage.php",
    "deep-check": [
      "@normalize:check",
      "@lint",
      "@coverage",
      "@infection",
      "@bench",
      "@fuzz:smoke",
      "@deps",
      "@rector:dry",
      "@backward-compatibility"
    ],
    "dependency-analyser": "composer-dependency-analyser",
    "deps": [
      "@dependency-analyser",
      "@unused",
      "@require-check"
    ],
    "deptrac": "deptrac analyze",
    "fuzz": "php-fuzzer fuzz fuzz/async-parse.php fuzz/corpus",
    "fuzz:coverage": "php-fuzzer report-coverage fuzz/async-parse.php fuzz/corpus fuzz/coverage",
    "fuzz:smoke": "php-fuzzer --max-runs=5000 --timeout=1 --len-control-factor=10 fuzz fuzz/async-parse.php fuzz/corpus",
    "infection": "php scripts/infection.php",
    "lint": [
      "@style",
      "@analyze",
      "@deptrac"
    ],
    "normalize:check": "composer normalize --dry-run --diff",
    "phan": "php .phan/phan.phar --color",
    "phpcbf": "phpcbf",
    "phpcs": "phpcs",
    "phpmd": "HOME=. php -d error_reporting='E_ALL & ~E_DEPRECATED & ~E_USER_DEPRECATED' vendor/bin/phpmd src text phpmd.xml",
    "phpstan": "php -d disable_functions=proc_open vendor/bin/phpstan analyse --memory-limit=512M",
    "psalm": "psalm",
    "rector": "rector process",
    "rector:dry": "rector process --dry-run",
    "require-check": "composer-require-checker check",
    "style": [
      "@phpcs",
      "@phpmd"
    ],
    "test": "phpunit",
    "unused": "composer-unused"
  },
  "scripts-descriptions": {
    "analyze": "Run static analysis (PHPStan + Psalm + Phan).",
    "backward-compatibility": "Check for backward-compatibility breaks against the previous version/API.",
    "bench": "Run microbenchmarks with PHPBench (aggregate report).",
    "check": "Run the standard local checks (lint + tests).",
    "ci": "Run CI pipeline (check + mutation testing).",
    "coverage": "Run test suite with coverage reporting (via scripts/coverage.php).",
    "deep-check": "Run the full, expensive quality gate (normalize, lint, coverage, mutation, benches, fuzz smoke, deps, rector dry-run, BC check).",
    "dependency-analyser": "Analyze dependency usage correctness (shipmonk/composer-dependency-analyser).",
    "deps": "Run dependency hygiene suite (dependency analyser + unused deps + require-check).",
    "deptrac": "Run architecture/dependency rules analysis (Deptrac).",
    "fuzz": "Run fuzzing over the async parser target using php-fuzzer.",
    "fuzz:coverage": "Generate fuzz coverage report for the async parser target.",
    "fuzz:smoke": "Run a short fuzzing smoke test (bounded runs/timeout) for CI confidence.",
    "infection": "Run mutation testing (via scripts/infection.php).",
    "lint": "Run lint suite (style + static analysis + architecture checks).",
    "normalize:check": "Verify composer.json is normalized (dry-run + diff).",
    "phan": "Run Phan static analysis (using local .phan/phan.phar).",
    "phpcbf": "Auto-fix coding standard violations (PHPCBF).",
    "phpcs": "Check coding standards (PHPCS).",
    "phpmd": "Run PHPMD ruleset checks on src/.",
    "phpstan": "Run PHPStan analysis.",
    "psalm": "Run Psalm analysis.",
    "rector": "Apply Rector automated refactorings.",
    "rector:dry": "Preview Rector refactorings without modifying files (dry-run).",
    "require-check": "Verify composer.json requirements match actual used symbols (composer-require-checker).",
    "style": "Run style checks (PHPCS + PHPMD).",
    "test": "Run unit tests (PHPUnit).",
    "unused": "Detect unused composer dependencies (composer-unused)."
  },
  "autoload": {
    "psr-4": {
      "Krvh\\MinimalPhpAsync\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Krvh\\MinimalPhpAsync\\Tests\\": "tests/"
    }
  }
}
